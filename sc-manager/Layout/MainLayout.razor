@inherits LayoutComponentBase
@using sc_manager.Services
@using Microsoft.AspNetCore.Components.Authorization
@using sc_manager.Models
@inject FirebaseAuthService AuthService
@inject FirestoreService Firestore
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject NotificationService NotificationService
@inject IJSRuntime JS
@implements IDisposable


<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <div class="theme-toggle-wrapper">
                <label class="theme-switch" for="theme-toggle">
                    <input type="checkbox" id="theme-toggle"
                           checked="@isDark"
                           @onchange="ToggleTheme"/>
                    <span class="slider">
                        <i class="bi bi-moon-stars-fill icon-dark"></i>
                        <i class="bi bi-sun-fill icon-light"></i>
                    </span>
                </label>
            </div>
            <div class="theme-toggle-wrapper">
                @if (!notificationsEnabled)
                {
                    <button class="btn btn-primary" @onclick="Enable" disabled="@isEnabling">
                        @(isEnabling ? "Wird aktiviert..." : "Benachrichtigungen aktivieren")
                    </button>
                }
                else
                {
                    <span class="text-success"><i class="bi bi-bell-fill"></i> Aktiv</span>
                }
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu">
                        <span class="user-info" @onclick="ToggleUserMenu">
                            <i class="bi bi-person-circle"></i>
                            <span class="user-email">Servus @_user?.Nickname!</span>
                        </span>

                        @if (_showUserMenu)
                        {
                            <a href="#" class="logout-link" @onclick="Logout" @onclick:preventDefault>Abmelden</a>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            @if (_showUserMenu)
            {
                <div class="click-outside-overlay" @onclick="CloseUserMenu"></div>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isDark = true;
    private User? _user;
    private bool _showUserMenu;

    private bool notificationsEnabled;
    private bool isEnabling;
    private const string VapidKey = "BN6ag6jbFww0gxHE8N-1imXdHVD5IFqW5UxmaHvb_xkeXlxNkl7l2fzlAklFHIsxg6g6KZ-2NJiG-ML-oo-6BEc"; // ggf. in FirebaseConfig auslagern

    protected override void OnInitialized()
    {
        NotificationService.OnNotificationReceived += HandleNotification;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JS.InvokeAsync<string>("themeInterop.getTheme");
            isDark = savedTheme != "light";
            await JS.InvokeVoidAsync("themeInterop.setTheme", isDark ? "dark" : "light");
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            await SetUser(authState.User.Identity?.Name);

            if (_user is not null)
            {
                await RegisterDeviceTokenAsync();
            }

            StateHasChanged();
        }
    }

    private async Task ToggleTheme(ChangeEventArgs e)
    {
        isDark = (bool)(e.Value ?? false);
        var theme = isDark ? "dark" : "light";
        await JS.InvokeVoidAsync("themeInterop.setTheme", theme);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private async Task SetUser(string email)
    {
        _user = await Firestore.GetWhereAsync<User>("user", "email", email);
    }

    private void ToggleUserMenu() => _showUserMenu = !_showUserMenu;
    private void CloseUserMenu() => _showUserMenu = false;

    private async Task Enable() => await RegisterDeviceTokenAsync();

    private async Task RegisterDeviceTokenAsync()
    {
        if (_user is null || notificationsEnabled || isEnabling) return;

        isEnabling = true;
        StateHasChanged();

        var token = await NotificationService.RequestPermissionAndGetTokenAsync(VapidKey);

        if (token is not null)
        {
            try
            {
                await Firestore.UpdateAsync("deviceToken", token, new
                {
                    userId = _user.Id,
                    token,
                    updatedAt = DateTime.UtcNow,
                    device = "web"
                });
            }
            catch (JSException e)
            {
                if (e.Message.Contains("No document to update"))
                {
                    await Firestore.SetAsync("deviceToken", token, new
                    {
                        userId = _user.Id,
                        token,
                        createdAt = DateTime.UtcNow,
                        device = "web"
                    });
                }
            }

            notificationsEnabled = true;
        }

        isEnabling = false;
        StateHasChanged();
    }

    private void HandleNotification(string? title, string? body) =>  InvokeAsync(StateHasChanged);

    public void Dispose() =>
        NotificationService.OnNotificationReceived -= HandleNotification;
}
