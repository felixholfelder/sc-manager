<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>
    
    <PropertyGroup>
        <APIKEY>$([System.Environment]::GetEnvironmentVariable('APIKEY'))</APIKEY>
        <AUTHDOMAIN>$([System.Environment]::GetEnvironmentVariable('AUTHDOMAIN'))</AUTHDOMAIN>
        <PROJECTID>$([System.Environment]::GetEnvironmentVariable('PROJECTID'))</PROJECTID>
        <STORAGEBUCKET>$([System.Environment]::GetEnvironmentVariable('STORAGEBUCKET'))</STORAGEBUCKET>
        <MESSAGINGSENDERID>$([System.Environment]::GetEnvironmentVariable('MESSAGINGSENDERID'))</MESSAGINGSENDERID>
        <APPID>$([System.Environment]::GetEnvironmentVariable('APPID'))</APPID>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="assets\" />
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js"
                       PublishedContent="wwwroot\service-worker.published.js" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Layout\EmptyLayout.razor" />
      <AdditionalFiles Include="Layout\RedirectToLogin.razor" />
    </ItemGroup>

</Project>
